# Copy to .env and fill in. Never commit .env.
# Muse Spark 1.3 via Meta OpenAI-compatible endpoint.
MODEL_NAME=muse-spark-1.3
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_TEMPERATURE=0.7
# Keys are fetched ONLY through the supplied AwsSecretManager (us-west-2).
# Authenticate the backend with your normal AWS profile or role.
# The secret must be JSON. Name the model's key if the secret has multiple keys.
# MODEL_SECRET_NAME=dev/AppAlpha/secrets
# MODEL_SECRET_KEY=Muse_API_KEY_TEST
# Optional second model on the same endpoint and key, tried when the first fails.
# MODEL_FALLBACK_NAME=
# Agent harness limits per run (one message or one approval resume).
# AGENT_MAX_MODEL_CALLS=50
# AGENT_MAX_TOOL_CALLS=50
# AGENT_MAX_TOOL_FAILURES=3
# AGENT_MODEL_RETRIES=2
# AssemblyAI transcription uses the same shared secret by default.
# ASSEMBLYAI_SECRET_NAME=dev/AppAlpha/secrets
# ASSEMBLYAI_SECRET_KEY=ASSEMBLYAI_API_KEY
