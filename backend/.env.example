# Copy to .env and fill in. Never commit .env.
# Muse Spark 1.3 via Meta OpenAI-compatible endpoint.
MODEL_NAME=muse-spark-1.3
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_TEMPERATURE=0.7
# Option A (local dev): put the key directly here
# MODEL_API_KEY=...
# Option B (AWS): leave MODEL_API_KEY empty; these default to your secret.
# Secret value may be the raw key or JSON; MODEL_SECRET_KEY names the JSON key.
# AWS_REGION=us-west-2
# MODEL_SECRET_NAME=Muse_API_KEY_TEST
# MODEL_SECRET_KEY=
