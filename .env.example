# Docker Compose configuration. Copy to .env to override these defaults.
APP_PORT=8080
MODEL_NAME=muse-spark-1.3
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_TEMPERATURE=0.7
MODEL_SECRET_NAME=dev/AppAlpha/secrets
MODEL_SECRET_KEY=Muse_API_KEY_TEST
# Optional second model on the same endpoint and key, tried when the first fails.
MODEL_FALLBACK_NAME=
# Agent harness limits per run (see backend/README.md, "Agent harness").
AGENT_MAX_MODEL_CALLS=50
AGENT_MAX_TOOL_CALLS=50
AGENT_MAX_TOOL_FAILURES=3
AGENT_MODEL_RETRIES=2
ASSEMBLYAI_SECRET_NAME=dev/AppAlpha/secrets
ASSEMBLYAI_SECRET_KEY=ASSEMBLYAI_API_KEY
AWS_PROFILE=default
# Optional absolute credential directory for compose.aws.yaml (defaults to ~/.aws).
# AWS_CONFIG_DIR=/home/your-user/.aws
